---
import { projects } from "../scripts/data.js";
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Scroll Image Distortion</title>
		<style is:global>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html {
				background: #f4f4f2;
			}

			body {
				margin: 0;
				overflow-x: hidden;
				background: #f4f4f2;
				color: #111;
				font-family: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
			}

			canvas {
				display: block;
			}

			main {
				position: relative;
				z-index: 1;
			}

			.page-intro,
			.page-outro {
				height: 40vh;
				display: grid;
				place-items: center;
				padding: 2rem;
				text-align: center;
			}

			.page-intro h1 {
				margin: 0;
				font-size: clamp(2rem, 6vw, 4.5rem);
				font-weight: 600;
				letter-spacing: -0.03em;
			}

			.page-intro p,
			.page-outro p {
				margin: 0.75rem 0 0;
				font-size: 1rem;
				opacity: 0.65;
			}

			.card-list {
				list-style: none;
				margin: 0 auto;
				padding: 0 1.5rem 4rem;
				max-width: 72rem;
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 3rem 1.75rem;
			}

			@media (max-width: 640px) {
				.card-list {
					grid-template-columns: 1fr;
					gap: 2.5rem;
				}
			}

			.card {
				display: block;
				color: inherit;
				text-decoration: none;
			}

			.card:hover .card-title,
			.card:focus-visible .card-title {
				opacity: 0.55;
			}

			.card-media {
				position: relative;
				overflow: hidden;
				aspect-ratio: 4 / 3;
				background: transparent;
			}

			.card-media img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: opacity 0.2s ease;
			}

			.card-title {
				margin: 0.9rem 0 0;
				font-size: clamp(1.15rem, 2.4vw, 1.6rem);
				font-weight: 600;
				letter-spacing: -0.02em;
				transition: opacity 0.2s ease;
			}

			#webgl-stage {
				pointer-events: none;
				position: fixed;
				inset: 0;
				width: 100%;
				height: 100vh;
				z-index: 2;
			}
		</style>
	</head>
	<body>
		<main>
			<section class="page-intro">
				<div>
					<h1>Scroll Image Distortion</h1>
					<p>カード画像はスクロール速度に応じて上下に歪みます</p>
				</div>
			</section>

			<ul class="card-list">
				{
					projects.map((project) => (
						<li>
							<a class="card" href={project.href}>
								<div
									class="card-media"
									data-src={project.src}
									data-title={project.title}
								>
									<img src={project.src} alt={project.title} loading="lazy" />
								</div>
								<p class="card-title">{project.title}</p>
							</a>
						</li>
					))
				}
			</ul>

			<section class="page-outro">
				<p>End of list</p>
			</section>
		</main>

		<div id="webgl-stage"></div>

		<script>
			import "../scripts/main.js";
		</script>
	</body>
</html>
